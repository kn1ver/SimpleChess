{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "packages/shared/*"
      ]
    }
  },
  "include": [
    "packages/**/src",
    "packages/client/postcss.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
